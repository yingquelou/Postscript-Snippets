# dev-only sources and tooling
src/
tests/
scripts/
docs/
.tests/
.scripts/
.workbuddy/
.trae/
.github/
.vscode/
tsconfig.json
tsconfig.scripts.json
snippets/
.vscodeignore
.gitignore

# prose/docs (README + CHANGELOG are re-included at the end)
*.md
*.txt
*.ps1
*.bat
**/*.map
icon.svg

# only the two runtime bundles ship from out/
out/**
!out/extension.js
!out/debugger/debugAdapter.js

# generated snippet set — the language server loads it at runtime
!.snippets/

# local sandboxes and packaging leftovers
ps.test/
pslib/
node_modules
*.vsix
*.log

# dependency manifests are for development only
pnpm-lock.yaml
pnpm-workspace.yaml
package-lock.json

!README.md
!CHANGELOG.md
