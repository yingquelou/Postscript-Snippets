{
	"name": "postscriptsnippets",
	"displayName": "PostScript Programming Language",
	"publisher": "yingquelou",
	"description": "PostScript (Ghostscript) language support for VS Code: syntax highlighting, code snippets, language server with intelligent completions, and a full-featured debugger with breakpoints, variable inspection, and step-through debugging",
	"version": "1.1.9",
	"license": "LGPL-3.0-only",
	"icon": "icon.png",
	"keywords": [
		"postscript",
		"ghostscript",
		"debugger",
		"language-server",
		"lsp",
		"snippets",
		"syntax-highlighting",
		"code-completion",
		"pdf-development"
	],
	"engines": {
		"vscode": "^1.70.3"
	},
	"activationEvents": [
		"onLanguage:postscript",
		"onDebugResolve:postscript",
		"onCommand:postscriptsnippets.compilePostscript",
		"onCommand:postscriptsnippets.validateWithGhostscript",
		"onCommand:postscriptsnippets.generateBuildTrace"
	],
	"categories": [
		"Snippets",
		"Programming Languages",
		"Debuggers"
	],
	"main": "out/extension.js",
	"contributes": {
		"configuration": [
			{
				"title": "PostScript Configuration",
				"properties": {
					"postscript.interpreter.executable": {
						"description": "PostScript interpreter executable path (leave empty for auto-detect on Windows: gswin64c → gswin32c → gs; on others: gs)",
						"type": "string"
					},
					"postscript.parser.markConsumingOperators": {
						"description": "Operators that consume the operand stack down to and including the nearest mark (e.g. cleartomark, pdfmark). Content since the mark is attached to the operator in the outline instead of being reported as an unclosed array.",
						"type": "array",
						"items": {
							"type": "string"
						},
						"default": [
							"cleartomark",
							"pdfmark"
						],
						"scope": "window"
					},
					"postscript.parser.markSuspendingOperators": {
						"description": "Operators that discard the whole operand stack below the current procedure (e.g. clear). Pending marks are dropped silently instead of being reported as orphan marks.",
						"type": "array",
						"items": {
							"type": "string"
						},
						"default": [
							"clear"
						],
						"scope": "window"
					}
				}
			}
		],
		"jsonValidation": [
			{
				"fileMatch": [
					"**/postscript.config.json"
				],
				"url": "./language/postscript.config.schema.json"
			}
		],
		"commands": [
			{
				"command": "postscriptsnippets.compilePostscript",
				"title": "Compile PostScript",
				"icon": "$(run)",
				"category": "PostScript"
			},
			{
				"command": "postscriptsnippets.validateWithGhostscript",
				"title": "Validate with Ghostscript",
				"icon": "$(check)",
				"category": "PostScript"
			},
			{
				"command": "postscriptsnippets.generateBuildTrace",
				"title": "Generate Build Trace",
				"icon": "$(list-ordered)",
				"category": "PostScript"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "postscriptsnippets.compilePostscript",
					"when": "editorLangId == postscript",
					"group": "navigation"
				}
			]
		},
		"grammars": [
			{
				"language": "postscript",
				"scopeName": "source.postscript",
				"path": "./language/postscript.tmLanguage.json"
			}
		],
		"breakpoints": [
			{
				"language": "postscript"
			}
		],
		"languages": [
			{
				"id": "postscript",
				"extensions": [
					".ps",
					".eps"
				],
				"aliases": [
					"PostScript",
					"GhostScript"
				],
				"configuration": "./language/language-configuration.json"
			}
		],
		"debuggers": [
			{
				"type": "postscript",
				"label": "PostScript (Ghostscript) Debugger",
				"program": "./out/debugger/debugAdapter.js",
				"runtime": "node",
				"languages": [
					"postscript"
				],
				"configurationAttributes": {
					"launch": {
						"properties": {
							"program": {
								"type": "string",
								"description": "PostScript file to run"
							},
							"ghostscriptPath": {
								"type": "string",
								"description": "Ghostscript executable path. If not set, uses the extension setting or platform default."
							},
							"cwd": {
								"type": "string",
								"description": "Working directory for the interpreter.",
								"default": "${workspaceFolder}"
							},
							"stopOnEntry": {
								"type": "boolean",
								"default": false,
								"description": "Whether to stop at the entry point when starting debugging. Default: false."
							},
							"args": {
								"type": "array",
								"description": "Additional arguments passed to Ghostscript.",
								"items": {
									"type": "string"
								}
							}
						}
					}
				},
				"configurationSnippets": [
					{
						"label": "Launch PostScript",
						"body": {
							"type": "postscript",
							"request": "launch",
							"name": "Launch PostScript",
							"program": "${file}",
							"cwd": "${workspaceFolder}"
						}
					}
				]
			}
		]
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/yingquelou/Postscript-Snippets.git"
	},
	"scripts": {
		"test": "node --test .tests/debugAdapter.test.js .tests/dictionaryStack.test.js .tests/completionStrategy.test.js .tests/dictionaryStackManager.test.js .tests/languageServer.test.js .tests/symbolBuilderMark.test.js .tests/configUtilsHardening.test.js .tests/compositionAnalysis.test.js .tests/gsIntegration.test.js .tests/gsVerificationState.test.js .tests/workspaceIndex.test.js .tests/PostScriptParser.test.js .tests/postscriptLexer.test.js .tests/syntaxTreeWalker.test.js .tests/symbolBuilderMultiline.test.js .tests/debugConfigurationParser.test.js .tests/streamingBlockParserCorrectness.test.js",
		"pretest": "tsc -b tests",
		"build:scripts": "tsc -b scripts",
		"build:snippets": "node .scripts/snippetsGenerator.js",
		"clean:out": "npm run build:scripts && node .scripts/clean.js out",
		"prebuild": "npm run build:scripts",
		"build": "node .scripts/esbuild.js",
		"postbuild": "npm run build:snippets",
		"prepackage": "npm run clean:out && npm run build",
		"prepublish": "npm run clean:out && npm run build",
		"preclean": "npm run build:scripts",
		"clean": "npm run restore:manifest && node .scripts/clean.js out .snippets .tests .scripts",
		"watch:scripts": "tsc -b scripts --watch",
		"prewatch": "npm run build",
		"watch": "node .scripts/esbuild.js --watch",
		"typecheck": "tsc -b src",
		"verify:ps": "node scripts/verify-ps-files.js",
		"verify:parity": "node scripts/verify-mark-parity.js",
		"verify:trace": "node scripts/verify-l3-trace.js",
		"verify": "npm run verify:parity && npm run verify:ps && npm run verify:trace",
		"package": "node .scripts/vsceRun.js package",
		"publish": "node .scripts/vsceRun.js publish",
		"restore:manifest": "node .scripts/restore.js"
	},
	"devDependencies": {
		"@types/node": "^25.9.1",
		"@types/vscode": "^1.70.3",
		"@vscode/debugadapter": "^1.68.0",
		"@vscode/debugprotocol": "^1.68.0",
		"@vscode/vsce": "^4.1.0",
		"chevrotain": "^12.0.0",
		"esbuild": "^0.28.0",
		"marked": "^18.0.4",
		"typescript": "^6.0.3",
		"vscode-jsonrpc": "^8.2.1",
		"vscode-languageclient": "^9.0.1",
		"vscode-languageserver": "^9.0.1",
		"vscode-languageserver-textdocument": "^1.0.12"
	}
}
