{
    "comments": {
        "lineComment": "%"
    },
    "brackets": [
        ["[", "]"],
        ["{", "}"],
        ["<", ">"],
        ["<~", "~>"],
        ["<<", ">>"]
    ],
    "colorizedBracketPairs": [
        ["[","]"],
        ["<<","]"],
        ["mark","]"],
        ["<<", ">>"],
        ["[", ">>"],
        ["mark", ">>"],
        ["<~", "~>"],
        ["<", ">"],
        ["{","}"]
    ],
    "autoClosingPairs": [
        ["(", ")"],
        ["[", "]"],
        ["{", "}"],
        ["<", ">"],
        ["<~", "~>"],
        ["<<", ">>"]
    ],
    "surroundingPairs": [
        ["(", ")"],
        ["[", "]"],
        ["{", "}"],
        ["<", ">"],
        ["<<", ">>"]
    ],
    "indentationRules": {
        "increaseIndentPattern": "\\[|\\{|<<|\\bmark\\b",
        "decreaseIndentPattern": "\\]|\\}|>>"
    },
    "wordPattern": "[^\\s\\[\\]{}<>/%()]+"
}