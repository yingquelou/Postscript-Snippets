{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PostScript",
  "scopeName": "source.postscript",
  "fileTypes": [
    "ps",
    "eps"
  ],
  "patterns": [
    {
      "include": "#content"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.percentage.postscript",
      "begin": "%",
      "end": "$"
    },
    "string": {
      "patterns": [
        {
          "include": "#string-ascii85"
        },
        {
          "include": "#string-hex"
        },
        {
          "include": "#string-literal"
        }
      ]
    },
    "string-ascii85": {
      "name": "string.quoted.double.ascii85.postscript",
      "begin": "<~",
      "end": "~>",
      "patterns": [
        {
          "name": "invalid.illegal.non-ascii85.postscript",
          "match": "[^!-u\\s~>]"
        }
      ]
    },
    "string-hex": {
      "name": "string.quoted.single.hex.postscript",
      "begin": "<(?![<~])",
      "end": ">",
      "patterns": [
        {
          "name": "invalid.illegal.non-hex.postscript",
          "match": "[^0-9A-Fa-f\\s]"
        }
      ]
    },
    "string-literal": {
      "name": "string.quoted.single.literal.postscript",
      "begin": "\\(",
      "end": "\\)",
      "patterns": [
        {
          "name": "constant.character.escape.postscript",
          "match": "\\\\(?:[nrtbf\\\\()]|[0-7]{1,3})"
        },
        {
          "name": "constant.character.escape.line-continuation.postscript",
          "match": "\\\\(?:\\r?\\n)",
          "group": "transparent"
        },
        {
          "begin": "\\(",
          "end": "\\)",
          "patterns": [
            {
              "include": "#string-literal"
            }
          ]
        }
      ]
    },
    "content": {
      "patterns": [
        {
          "include": "#container"
        },
        {
          "include": "#procedure"
        },
        {
          "include": "#comment"
        },
        {
          "include": "#number"
        },
        {
          "include": "#string"
        },
        {
          "include": "#name"
        }
      ]
    },
    "container": {
      "name": "meta.container.postscript",
      "begin": "(\\[|<<|\\bmark\\b)",
      "end": "(\\]|>>)",
      "patterns": [
        {
          "include": "#content"
        }
      ]
    },
    "procedure": {
      "name": "meta.procedure.postscript",
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "#content"
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.radix.postscript",
          "match": "([2-9]|1[0-9]|2[0-9]|3[0-6])#[0-9A-Za-z]+"
        },
        {
          "name": "constant.numeric.float.postscript",
          "match": "[+-]?\\d+[eE][+-]?\\d+|[+-]?(?:\\d+\\.\\d*|\\.\\d+)(?:[eE][+-]?\\d+)?"
        },
        {
          "name": "constant.numeric.integer.postscript",
          "match": "[+-]?\\d+"
        }
      ]
    },
    "name": {
      "patterns": [
        {
          "name": "meta.preprocessor.name.postscript",
          "begin": "//",
          "end": "(?=[\\s{}/()\\]\\[%])"
        },
        {
          "name": "variable.name.postscript",
          "begin": "/",
          "end": "(?=[\\s{}/()\\]\\[%])"
        },
        {
          "name": "entity.name.function.postscript",
          "match": "(?:[^\\s{}/()\\]\\[%])+"
        }
      ]
    }
  }
}